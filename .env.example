# storr. Environment Configuration
# Optional: Set these if you want to pre-configure your GitHub repository credentials
# If omitted, storr. will prompt you on first open via the in-app /setup screen.

NEXT_PUBLIC_GITHUB_OWNER=your-github-username
NEXT_PUBLIC_GITHUB_REPO=your-private-resume-repo
NEXT_PUBLIC_GITHUB_TOKEN=github_pat_your_fine_grained_personal_access_token

